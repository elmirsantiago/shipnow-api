
# Entorno: development, test o production
NODE_ENV=development

# Puerto de la API
PORT=8080

# MongoDB local (ejemplo, sin credenciales)
MONGODB_URI=mongodb://127.0.0.1:27017/shipnow

# Niveles: fatal, error, warning, info, http, debug
LOG_LEVEL=debug

# URL opcional de un servicio externo
EXTERNAL_SERVICE_URL=
