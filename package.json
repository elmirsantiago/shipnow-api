
{
  "name": "shipnow-api",
  "version": "1.0.0",
  "description": "API REST base para la gestión de logística y envíos.",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:functional": "node --env-file=.env.test ./node_modules/mocha/bin/mocha.js \"test/functional/**/*.test.js\" --timeout 15000"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/test/functional/"
    ]
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "chai": "^6.3.0",
    "jest": "^30.5.2",
    "mocha": "^12.0.3",
    "nodemon": "^3.1.9",
    "supertest": "^7.3.1"
  }
}
